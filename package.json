{
  "name": "budget-app",
  "version": "0.1.0",
  "description": "An Adwaita application built with node-gtk.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run dev:css-reload",
    "dev:css-reload": "cross-env NODE_ENV=development node --import tsx --import node-gtk/register src/main.ts",
    "dev:app-reload": "cross-env NODE_ENV=development node --import tsx --import node-gtk/register --watch src/main.ts",
    "start": "node --import tsx --import node-gtk/register src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-types": "node-gtk generate-types Gtk-4.0 Adw-1",
    "postinstall": "npm run generate-types"
  },
  "dependencies": {
    "node-gtk": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-gtk@4.1.1": true
  },
  "main": "src/main.js",
  "bundle": {
    "name": "Budget App",
    "id": "com.example.BudgetApp",
    "entry": "src/main.js",
    "gtk": 4,
    "include": [
      "src/**",
      "assets/**"
    ],
    "nodeArgs": [
      "--max-old-space-size=512"
    ],
    "register": true,
    "libraries": [
      "libgstreamer-1.0.so.0"
    ],
    "omitPackages": [
      "some-dev-helper"
    ],
    "icons": false,
    "node": "vendor/node",
    "out": "release"
  }
}
